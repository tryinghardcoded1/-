rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    match /profiles/{uid} {
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /searchHistory/{searchId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /scam_reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /global_blacklist/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /search_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
